<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.xuele.infrastructure.dao.ISCSkuActivityDao">

    <resultMap id="dataMap" type="cn.xuele.infrastructure.dao.po.SCSkuActivity">
        <id column="id" property="id"/>
        <result column="source" property="source"/>
        <result column="channel" property="channel"/>
        <result column="activity_id" property="activityId"/>
        <result column="goods_id" property="goodsId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="querySCSkuActivityVO" resultMap="dataMap"
            parameterType="cn.xuele.infrastructure.dao.po.SCSkuActivity">
        select goods_id, activity_id, source, channel
        from sc_sku_activity
        where goods_id = #{goodsId} and source = #{source} and channel = #{channel}
    </select>

</mapper>